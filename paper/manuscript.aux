\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Ablation experiment heatmap.} DirectOcc (\%) for 6 ablation conditions across 10 pockets. Color intensity indicates occupancy rate. White cells: zero occupancy. v7.1\_full (top row) achieves the best balance of high occupancy and pocket coverage. $\lambda =2.5$ achieves higher peak occupancy but fails on more pockets. $\lambda =10.0$ achieves 100\% pocket coverage but lower per-pocket occupancy.}}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:ablation}{{2}{6}{\textbf {Ablation experiment heatmap.} DirectOcc (\%) for 6 ablation conditions across 10 pockets. Color intensity indicates occupancy rate. White cells: zero occupancy. v7.1\_full (top row) achieves the best balance of high occupancy and pocket coverage. $\lambda =2.5$ achieves higher peak occupancy but fails on more pockets. $\lambda =10.0$ achieves 100\% pocket coverage but lower per-pocket occupancy}{figure.caption.4}{}}
