\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {v6-D.2 vs.\ v7.1 comparison.} v6-D.2 (coordinate-only guidance) achieved 0\% DirectOcc across all pockets. v7.1 (two-stage topology control) achieves 7/10 pockets with non-zero occupancy, demonstrating that topology-level intervention is necessary for water displacement.}}{9}{figure.caption.10}\protected@file@percent }
\newlabel{fig:v6v7}{{5}{9}{\textbf {v6-D.2 vs.\ v7.1 comparison.} v6-D.2 (coordinate-only guidance) achieved 0\% DirectOcc across all pockets. v7.1 (two-stage topology control) achieves 7/10 pockets with non-zero occupancy, demonstrating that topology-level intervention is necessary for water displacement}{figure.caption.10}{}}
