\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {DirectOcc rates across 10 PDBbind pockets.} Bars show the percentage of generated molecules (25/pocket) with $\ge 1$ compatible atom within 2.5\,\r A\ of a HEW site. Error bars: 95\% Clopper--Pearson exact binomial confidence intervals. The dashed red line at 0\% marks the v6-D.2 baseline. 7/10 pockets achieved DirectOcc $> 0\%$.}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:directocc}{{1}{4}{\textbf {DirectOcc rates across 10 PDBbind pockets.} Bars show the percentage of generated molecules (25/pocket) with $\ge 1$ compatible atom within 2.5\,\AA \ of a HEW site. Error bars: 95\% Clopper--Pearson exact binomial confidence intervals. The dashed red line at 0\% marks the v6-D.2 baseline. 7/10 pockets achieved DirectOcc $> 0\%$}{figure.caption.2}{}}
