\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Kinetic Path Energy (KPE) decomposition across guidance strategies.} $E_{\text  {ODE}}$: kinetic energy of ODE transport. $E_{\text  {guide}}$: kinetic energy injected by guidance signal. $\ensuremath  {\rho _{\text  {KPE}}}$: fraction of total energy from guidance (lower is better). Hard-fix injects 31,468$\times $ more guidance energy than kinematic anchoring, with $\ensuremath  {\rho _{\text  {KPE}}}$ spanning three orders of magnitude (98.5\% vs.\ 0.006\%).\relax }}{9}{table.caption.2}\protected@file@percent }
\newlabel{tab:kpe}{{2}{9}{\textbf {Kinetic Path Energy (KPE) decomposition across guidance strategies.} $E_{\text {ODE}}$: kinetic energy of ODE transport. $E_{\text {guide}}$: kinetic energy injected by guidance signal. $\KPERatio $: fraction of total energy from guidance (lower is better). Hard-fix injects 31,468$\times $ more guidance energy than kinematic anchoring, with $\KPERatio $ spanning three orders of magnitude (98.5\% vs.\ 0.006\%).\relax }{table.caption.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Kinematic Guidance Outperforms Naive Fixation by Eliminating Kinetic Strain}{9}{subsection.4.2}\protected@file@percent }
\citation{guan2023targetdiff}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Five-pocket comprehensive evaluation of kinematic anchor guidance.} DirectOcc: fraction of molecules with $\ge 1$ compatible atom within 2.5\,\r A{} of a HEW site (higher is better). Vina: mean docking score in kcal/mol (more negative is better). QED: drug-likeness (0--1). POSU: Physical Opportunity Site Utilization (0--1). $\sigma _{\text  {Vina}}$: standard deviation of Vina scores (lower is better---indicates stability). For each pocket, best value in \textbf  {bold}. Wilcoxon signed-rank test across all 6 pockets comparing Vina (Kinematic) vs.\ Vina (Hard-Fix): $\bm  {p = 4 \times 10^{-6}}$.\relax }}{10}{table.caption.3}\protected@file@percent }
\newlabel{tab:five_pocket}{{3}{10}{\textbf {Five-pocket comprehensive evaluation of kinematic anchor guidance.} DirectOcc: fraction of molecules with $\ge 1$ compatible atom within 2.5\,\AA {} of a HEW site (higher is better). Vina: mean docking score in kcal/mol (more negative is better). QED: drug-likeness (0--1). POSU: Physical Opportunity Site Utilization (0--1). $\sigma _{\text {Vina}}$: standard deviation of Vina scores (lower is better---indicates stability). For each pocket, best value in \textbf {bold}. Wilcoxon signed-rank test across all 6 pockets comparing Vina (Kinematic) vs.\ Vina (Hard-Fix): $\bm {p = 4 \times 10^{-6}}$.\relax }{table.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Model-Agnosticity: Cross-Validation on TargetDiff}{10}{subsection.4.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Cross-validation on TargetDiff confirms zero-strain superiority.} DirectOcc: fraction of molecules with $\ge 1$ compatible atom within 2.5\,\r A{} of a HEW site. Valid: number of chemically valid reconstructed molecules. Kinematic anchoring achieves 92\% validity on 6o4x versus 0\% for hard-fix, demonstrating that the zero-strain guarantee is generator-agnostic.\relax }}{10}{table.caption.4}\protected@file@percent }
\newlabel{tab:targetdiff}{{4}{10}{\textbf {Cross-validation on TargetDiff confirms zero-strain superiority.} DirectOcc: fraction of molecules with $\ge 1$ compatible atom within 2.5\,\AA {} of a HEW site. Valid: number of chemically valid reconstructed molecules. Kinematic anchoring achieves 92\% validity on 6o4x versus 0\% for hard-fix, demonstrating that the zero-strain guarantee is generator-agnostic.\relax }{table.caption.4}{}}
