\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces \textbf  {Failure case of two-stage generation in sterically inaccessible pockets (2jke, $N=50$/condition, CoM projection).} In deeply buried HEW sites, Phase\nobreakspace  {}1 anchor placement in geometrically constrained regions induces internal strain during Phase\nobreakspace  {}2 connection (Strain 146.5 vs.\ 92.1 for single-stage), without achieving site occupancy. This defines the rigid-body assumption's geometric boundary condition.\relax }}{27}{table.caption.26}\protected@file@percent }
\newlabel{tab:app_2jke_failure}{{13}{27}{\textbf {Failure case of two-stage generation in sterically inaccessible pockets (2jke, $N=50$/condition, CoM projection).} In deeply buried HEW sites, Phase~1 anchor placement in geometrically constrained regions induces internal strain during Phase~2 connection (Strain 146.5 vs.\ 92.1 for single-stage), without achieving site occupancy. This defines the rigid-body assumption's geometric boundary condition.\relax }{table.caption.26}{}}
