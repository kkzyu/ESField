\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Overview of the kinematic anchor guidance framework.} Panel\nobreakspace  {}1: Input protein pocket with detected HEW sites and the heuristic compatibility matrix $M$ encoding atom-type preferences for each microenvironment class. Panel\nobreakspace  {}2: Phase\nobreakspace  {}1 (Occupy)---small fragments are generated from noise under strong $E_{\text  {site}}$ guidance to place chemically compatible anchor atoms at HEW sites. Panel\nobreakspace  {}3: Phase\nobreakspace  {}2 (Connect \& KAG)---the full molecule is grown around anchors; the site-compatibility gradient is orthogonally decomposed and projected exclusively onto the CoM subspace, producing a uniform rigid-body translation that preserves all internal coordinates (Theorem\nobreakspace  {}\ref  {thm:zero_strain}). Panel\nobreakspace  {}4: Output---a complete drug-like molecule occupying target HEW sites with near-zero KPE contamination ($\rho _{\text  {KPE}} \approx 0.006\%$).\relax }}{4}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:framework_overview}{{1}{4}{\textbf {Overview of the kinematic anchor guidance framework.} Panel~1: Input protein pocket with detected HEW sites and the heuristic compatibility matrix $M$ encoding atom-type preferences for each microenvironment class. Panel~2: Phase~1 (Occupy)---small fragments are generated from noise under strong $E_{\text {site}}$ guidance to place chemically compatible anchor atoms at HEW sites. Panel~3: Phase~2 (Connect \& KAG)---the full molecule is grown around anchors; the site-compatibility gradient is orthogonally decomposed and projected exclusively onto the CoM subspace, producing a uniform rigid-body translation that preserves all internal coordinates (Theorem~\ref {thm:zero_strain}). Panel~4: Output---a complete drug-like molecule occupying target HEW sites with near-zero KPE contamination ($\rho _{\text {KPE}} \approx 0.006\%$).\relax }{figure.caption.1}{}}
