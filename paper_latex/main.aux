\newlabel{sec:kpe_validation}{{4.3}{11}{Mechanism Validation: Zero-Strain Guarantee via KPE}{subsection.4.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Kinetic Path Energy (KPE) decomposition across guidance strategies.} $E_{\text  {ODE}}$: kinetic energy of ODE transport. $E_{\text  {guide}}$: kinetic energy injected by guidance signal. $\ensuremath  {\rho _{\text  {KPE}}}$: fraction of total energy from guidance (lower is better). Hard-fix injects 31,468$\times $ more guidance energy than kinematic anchoring, with $\ensuremath  {\rho _{\text  {KPE}}}$ spanning three orders of magnitude (98.5\% vs.\ 0.006\%).\relax }}{12}{table.caption.5}\protected@file@percent }
\newlabel{tab:kpe}{{3}{12}{\textbf {Kinetic Path Energy (KPE) decomposition across guidance strategies.} $E_{\text {ODE}}$: kinetic energy of ODE transport. $E_{\text {guide}}$: kinetic energy injected by guidance signal. $\KPERatio $: fraction of total energy from guidance (lower is better). Hard-fix injects 31,468$\times $ more guidance energy than kinematic anchoring, with $\KPERatio $ spanning three orders of magnitude (98.5\% vs.\ 0.006\%).\relax }{table.caption.5}{}}
\citation{lai2025force}
\citation{lai2025force}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Kinetic Path Energy trajectory diagnostics.} \textbf  {(a)} KPE accumulation along the ODE integration trajectory for three conditions: unguided baseline (black), hard-fix (red), and kinematic anchoring (blue). Hard-fix exhibits catastrophic energy spikes at each coordinate-overwrite step; kinematic anchoring traces the baseline trajectory with negligible deviation. \textbf  {(b)} Instantaneous velocity norm $\|\bm  {v}_{\text  {eff}}\|$ vs.\ integration step. Hard-fix spikes reach 1,200$\times $ the baseline median; kinematic anchoring remains within $1.05\times $ of baseline throughout. \textbf  {(c)} Cumulative KPE ratio $\ensuremath  {\rho _{\text  {KPE}}}$ over the trajectory. Hard-fix saturates at 98.5\% after the first few fixations; kinematic anchoring plateaus at 0.006\%. \textbf  {(d)} Distribution of per-molecule KPE ratios (violin plots, $N=50$ per condition). Kinematic anchoring exhibits near-zero KPE contamination with negligible dispersion.\relax }}{13}{figure.caption.6}\protected@file@percent }
\newlabel{fig:kpe_trajectory}{{3}{13}{\textbf {Kinetic Path Energy trajectory diagnostics.} \textbf {(a)} KPE accumulation along the ODE integration trajectory for three conditions: unguided baseline (black), hard-fix (red), and kinematic anchoring (blue). Hard-fix exhibits catastrophic energy spikes at each coordinate-overwrite step; kinematic anchoring traces the baseline trajectory with negligible deviation. \textbf {(b)} Instantaneous velocity norm $\|\bm {v}_{\text {eff}}\|$ vs.\ integration step. Hard-fix spikes reach 1,200$\times $ the baseline median; kinematic anchoring remains within $1.05\times $ of baseline throughout. \textbf {(c)} Cumulative KPE ratio $\KPERatio $ over the trajectory. Hard-fix saturates at 98.5\% after the first few fixations; kinematic anchoring plateaus at 0.006\%. \textbf {(d)} Distribution of per-molecule KPE ratios (violin plots, $N=50$ per condition). Kinematic anchoring exhibits near-zero KPE contamination with negligible dispersion.\relax }{figure.caption.6}{}}
