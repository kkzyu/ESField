\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Literature-calibrated hydration free energy estimates by microenvironment class.} $\Delta G_{\text  {est}}$ ranges are derived from published WaterMap\nobreakspace  {}\cite  {abel2008} and GIST\nobreakspace  {}\cite  {nguyen2012gist} studies, not from site-specific explicit-solvent calculations. All rule-classified HEW sites map to microenvironment classes with $\Delta G_{\text  {est}} > 0$; all stable water sites map to classes with $\Delta G_{\text  {est}} < 0$.\relax }}{11}{table.caption.5}\protected@file@percent }
\newlabel{tab:hew_thermo}{{5}{11}{\textbf {Literature-calibrated hydration free energy estimates by microenvironment class.} $\Delta G_{\text {est}}$ ranges are derived from published WaterMap~\cite {abel2008} and GIST~\cite {nguyen2012gist} studies, not from site-specific explicit-solvent calculations. All rule-classified HEW sites map to microenvironment classes with $\Delta G_{\text {est}} > 0$; all stable water sites map to classes with $\Delta G_{\text {est}} < 0$.\relax }{table.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Figure 1: KPE Trajectory Diagnostics}{13}{subsection.4.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Kinetic Path Energy trajectory diagnostics.} \textbf  {(a)} KPE accumulation along the ODE integration trajectory for three conditions: unguided baseline (black), hard-fix (red), and kinematic anchoring (blue). Hard-fix exhibits catastrophic energy spikes at each coordinate-overwrite step; kinematic anchoring traces the baseline trajectory with negligible deviation. \textbf  {(b)} Instantaneous velocity norm $\|\bm  {v}_{\text  {eff}}\|$ vs.\ integration step. Hard-fix spikes reach 1,200$\times $ the baseline median; kinematic anchoring remains within $1.05\times $ of baseline throughout. \textbf  {(c)} Cumulative KPE ratio $\ensuremath  {\rho _{\text  {KPE}}}$ over the trajectory. Hard-fix saturates at 98.5\% after the first few fixations; kinematic anchoring plateaus at 0.006\%. \textbf  {(d)} Distribution of per-molecule KPE ratios (violin plots, $N=50$ per condition). Kinematic anchoring exhibits near-zero KPE contamination with minimal variance.\relax }}{13}{figure.caption.6}\protected@file@percent }
\newlabel{fig:kpe_trajectory}{{1}{13}{\textbf {Kinetic Path Energy trajectory diagnostics.} \textbf {(a)} KPE accumulation along the ODE integration trajectory for three conditions: unguided baseline (black), hard-fix (red), and kinematic anchoring (blue). Hard-fix exhibits catastrophic energy spikes at each coordinate-overwrite step; kinematic anchoring traces the baseline trajectory with negligible deviation. \textbf {(b)} Instantaneous velocity norm $\|\bm {v}_{\text {eff}}\|$ vs.\ integration step. Hard-fix spikes reach 1,200$\times $ the baseline median; kinematic anchoring remains within $1.05\times $ of baseline throughout. \textbf {(c)} Cumulative KPE ratio $\KPERatio $ over the trajectory. Hard-fix saturates at 98.5\% after the first few fixations; kinematic anchoring plateaus at 0.006\%. \textbf {(d)} Distribution of per-molecule KPE ratios (violin plots, $N=50$ per condition). Kinematic anchoring exhibits near-zero KPE contamination with minimal variance.\relax }{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6}Figure 2: Simultaneous Improvement in Occupancy and Affinity}{14}{subsection.4.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Simultaneous Pareto-improvement in occupancy and affinity.} \textbf  {(a)} Four-quadrant scatter: each point represents one pocket's mean performance under kinematic anchoring relative to hard-fix, with $x$-axis = $\Delta $Vina (kinematic $-$ hard-fix, negative = improvement) and $y$-axis = $\Delta $DirectOcc (kinematic $-$ hard-fix, positive = improvement). All 6 pockets occupy the Pareto-dominant top-right quadrant (better occupancy, better affinity), demonstrating that zero-strain guidance achieves what naive fixation cannot: simultaneous improvement in both dimensions. \textbf  {(b)} Vina score box plots for three representative pockets (3mfw, 2gni, 6o4x), comparing baseline, hard-fix, and kinematic conditions. Kinematic anchoring (blue) consistently achieves more favorable (more negative) Vina scores with substantially reduced variance. Stars denote Wilcoxon signed-rank significance: ${}^{**}\,p < 0.01$, ${}^{***}\,p < 0.001$.\relax }}{14}{figure.caption.7}\protected@file@percent }
\newlabel{fig:quadrant_boxplot}{{2}{14}{\textbf {Simultaneous Pareto-improvement in occupancy and affinity.} \textbf {(a)} Four-quadrant scatter: each point represents one pocket's mean performance under kinematic anchoring relative to hard-fix, with $x$-axis = $\Delta $Vina (kinematic $-$ hard-fix, negative = improvement) and $y$-axis = $\Delta $DirectOcc (kinematic $-$ hard-fix, positive = improvement). All 6 pockets occupy the Pareto-dominant top-right quadrant (better occupancy, better affinity), demonstrating that zero-strain guidance achieves what naive fixation cannot: simultaneous improvement in both dimensions. \textbf {(b)} Vina score box plots for three representative pockets (3mfw, 2gni, 6o4x), comparing baseline, hard-fix, and kinematic conditions. Kinematic anchoring (blue) consistently achieves more favorable (more negative) Vina scores with substantially reduced variance. Stars denote Wilcoxon signed-rank significance: ${}^{**}\,p < 0.01$, ${}^{***}\,p < 0.001$.\relax }{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.7}Figure 3: 3D Conformational Comparison}{15}{subsection.4.7}\protected@file@percent }
\newlabel{fig:3d_a}{{3a}{15}{Hard-Fix (Vina worst): severe steric clashes\relax }{figure.caption.8}{}}
\newlabel{sub@fig:3d_a}{{a}{15}{Hard-Fix (Vina worst): severe steric clashes\relax }{figure.caption.8}{}}
\newlabel{fig:3d_b}{{3b}{15}{Kinematic (Vina best): relaxed, complementary\relax }{figure.caption.8}{}}
\newlabel{sub@fig:3d_b}{{b}{15}{Kinematic (Vina best): relaxed, complementary\relax }{figure.caption.8}{}}
\newlabel{fig:3d_c}{{3c}{15}{Crystal reference ligand\relax }{figure.caption.8}{}}
\newlabel{sub@fig:3d_c}{{c}{15}{Crystal reference ligand\relax }{figure.caption.8}{}}
\newlabel{fig:3d_d}{{3d}{15}{Combined overlay: hard-fix (red), kinematic (green), crystal (yellow)\relax }{figure.caption.8}{}}
\newlabel{sub@fig:3d_d}{{d}{15}{Combined overlay: hard-fix (red), kinematic (green), crystal (yellow)\relax }{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {3D conformational comparison (3mfw pocket).} Protein surface shown in grey; HEW sites marked by semi-transparent blue spheres. \textbf  {(a)} Hard-fix molecule (red): rigidly fixed anchor atoms produce a strained, clash-ridden conformation. \textbf  {(b)} Kinematic molecule (green): CoM-only guidance preserves internal flexibility, yielding a relaxed pose. \textbf  {(c)} Crystal reference ligand (yellow). \textbf  {(d)} Overlay of all three, illustrating the conformational collapse caused by hard-fix versus the natural relaxation under kinematic guidance.\relax }}{15}{figure.caption.8}\protected@file@percent }
\newlabel{fig:3d_comparison}{{3}{15}{\textbf {3D conformational comparison (3mfw pocket).} Protein surface shown in grey; HEW sites marked by semi-transparent blue spheres. \textbf {(a)} Hard-fix molecule (red): rigidly fixed anchor atoms produce a strained, clash-ridden conformation. \textbf {(b)} Kinematic molecule (green): CoM-only guidance preserves internal flexibility, yielding a relaxed pose. \textbf {(c)} Crystal reference ligand (yellow). \textbf {(d)} Overlay of all three, illustrating the conformational collapse caused by hard-fix versus the natural relaxation under kinematic guidance.\relax }{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.8}Ablation: Guidance Scheduling and Strength}{16}{subsection.4.8}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {Ablation of kinematic guidance hyperparameters.} $\lambda _{\qopname  \relax m{max}}$: peak guidance strength. Schedule: ``quadratic'' = $(1-t)^2$ decay; ``constant'' = uniform $\lambda $; ``late\_onset'' = SV-Flow style. Mean values across all 6 pockets (300 molecules/condition). Best value in each column in \textbf  {bold}.\relax }}{16}{table.caption.9}\protected@file@percent }
\newlabel{tab:ablation}{{6}{16}{\textbf {Ablation of kinematic guidance hyperparameters.} $\lambda _{\max }$: peak guidance strength. Schedule: ``quadratic'' = $(1-t)^2$ decay; ``constant'' = uniform $\lambda $; ``late\_onset'' = SV-Flow style. Mean values across all 6 pockets (300 molecules/condition). Best value in each column in \textbf {bold}.\relax }{table.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Ablation heatmap: guidance schedule $\times $ $\lambda _{\qopname  \relax m{max}}$.} DirectOcc (\textbf  {a}), Vina score (\textbf  {b}), and KPE ratio (\textbf  {c}) for $\lambda _{\qopname  \relax m{max}}=1.0$ across three scheduling strategies. Quadratic decay achieves the optimal balance: highest Vina scores, lowest variance, and strong HEW occupancy with minimal KPE contamination.\relax }}{16}{figure.caption.10}\protected@file@percent }
\newlabel{fig:ablation_heatmap}{{4}{16}{\textbf {Ablation heatmap: guidance schedule $\times $ $\lambda _{\max }$.} DirectOcc (\textbf {a}), Vina score (\textbf {b}), and KPE ratio (\textbf {c}) for $\lambda _{\max }=1.0$ across three scheduling strategies. Quadratic decay achieves the optimal balance: highest Vina scores, lowest variance, and strong HEW occupancy with minimal KPE contamination.\relax }{figure.caption.10}{}}
